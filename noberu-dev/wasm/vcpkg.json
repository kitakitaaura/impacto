{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "impacto-noberu-web",
  "version-string": "0",
  "builtin-baseline": "62159a45e18f3a9ac0548628dcaf74fcb60c6ff9",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false
    },
    "libogg",
    "libvorbis",
    "opus",
    "zlib",
    "libwebp",
    "fmt",
    "glm",
    "pugixml",
    "utfcpp",
    "concurrentqueue",
    "readerwriterqueue",
    "unordered-dense",
    "boost-circular-buffer",
    "toml11",
    "freetype",
    "harfbuzz"
  ],
  "overrides": [
    {
      "name": "sdl3",
      "version": "3.4.0"
    }
  ],
  "features": {
    "movies": {
      "description": "Decoder-only FFmpeg (Bink 2), avcpp and libass for the threaded build's movie player",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample",
            "swscale"
          ]
        },
        {
          "name": "avcpp",
          "default-features": false
        },
        "libass"
      ]
    }
  }
}
